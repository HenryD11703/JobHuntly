# JobHuntly backend configuration.
# Copy this file to `.env` in the repository root and fill in the values.
# `.env` is git-ignored: never commit real values.
# Double underscores map to nested config sections in ASP.NET Core
# (ConnectionStrings__DefaultConnection -> ConnectionStrings:DefaultConnection).

# --- Database (PostgreSQL) ---
# Neon gives a URI like postgresql://user:password@host/dbname?sslmode=require
# Use your DEVELOPMENT database here, never the production one.
ConnectionStrings__DefaultConnection=

# --- JWT ---
# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JwtSettings__Secret=
JwtSettings__Issuer=JobHuntly
JwtSettings__Audience=JobHuntlyApp
JwtSettings__ExpiryMinutes=120

# --- CORS ---
# Comma-separated list of frontend origins allowed to call the API.
Cors__AllowedOrigins=http://localhost:3000

# --- AI (Groq). Optional: the app works without it. ---
Groq__ApiKey=
Groq__Model=openai/gpt-oss-120b
# Seconds to wait for the model before giving up (the app falls back to manual entry).
Groq__TimeoutSeconds=10
# Daily AI calls per user. Demo sandbox users get the lower limit.
Ai__DailyLimit=30
Ai__DemoDailyLimit=8
